# ── Backend proxy (used by Next.js rewrites + server-side fetches) ───────────
# URL of the FastAPI backend
# Local dev: http://localhost:8001
# Production: your Render service URL
BACKEND_URL=http://localhost:8001

# ── SSE stream URL (used client-side — must be publicly reachable) ───────────
# Same as BACKEND_URL in local dev; set to Render URL in production
NEXT_PUBLIC_API_URL=http://localhost:8001

# ── Hosted platform (leave blank for local / open-source use) ────────────────
# true  = auth + billing UI enabled (login, register, billing pages, credit gate)
# false or unset = open-source mode, no login required
NEXT_PUBLIC_HOSTED_MODE=

# Supabase project credentials (required when NEXT_PUBLIC_HOSTED_MODE=true)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — server-side only, never exposed to the browser
# Used by billing API routes to write credits (bypasses RLS)
SUPABASE_SECRET_KEY=

# Stripe (required when NEXT_PUBLIC_HOSTED_MODE=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe dashboard (one-time payment products)
STRIPE_PRICE_5=
STRIPE_PRICE_10=
STRIPE_PRICE_25=
