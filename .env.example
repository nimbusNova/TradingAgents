# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=

# ── Hosted platform (leave blank for local / open-source use) ────────────────
# Set USE_ACTUAL_DB=true to use Supabase Postgres instead of local SQLite
USE_ACTUAL_DB=

# Backend — Supabase connection (required when USE_ACTUAL_DB=true)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3001

# Frontend — Supabase auth (required when NEXT_PUBLIC_HOSTED_MODE=true)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Frontend — hosted mode flag
# true  = auth + billing UI enabled (login, register, billing pages, credit gate)
# false or unset = open-source mode, no login required
NEXT_PUBLIC_HOSTED_MODE=

# Frontend — backend URL for SSE stream
# Local dev: http://localhost:8001
# Production: your Render service URL
NEXT_PUBLIC_API_URL=http://localhost:8001

# Stripe (required when NEXT_PUBLIC_HOSTED_MODE=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_5=
STRIPE_PRICE_10=
STRIPE_PRICE_25=
