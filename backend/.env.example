# ── LLM Providers (set the one you use) ─────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware
# Local dev: http://localhost:3001
# Production: your Vercel frontend URL(s)
ALLOWED_ORIGINS=http://localhost:3001

# ── Hosted platform (leave blank for local / open-source use) ────────────────
# true  = use Supabase Postgres + real auth; false or unset = SQLite (default)
USE_ACTUAL_DB=

# Supabase Postgres connection (required when USE_ACTUAL_DB=true)
# Use the pgbouncer pooler URL from Supabase dashboard → Settings → Database
DATABASE_URL=

# Supabase project credentials (required when USE_ACTUAL_DB=true)
SUPABASE_URL=
# Service role key — bypasses RLS; used for credit ledger + trading_memory writes
SUPABASE_SECRET_KEY=
# JWT secret — used to verify Supabase-issued access tokens on API requests
# Found in Supabase dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
